go.property("resolution", 2048)

function init(self)
	msg.post("@render:", "set_directional_shadow", {
		camera = msg.url("#shadow_camera"),
		resolution = self.resolution,
		pcf_kernel_size = 5,
		pcf_sample_spacing = 0.9,
		polygon_offset_factor = 2.0,
		polygon_offset_units = 4.0,
		receiver_min_bias = 0.0008,
		receiver_slope_bias = 0.002,
	})
end
